// agent.song - Savannah AgentNode contract, v1
// Claude-to-Claude agent mesh on the song substrate.
// v1 is deliberately stateless: every ask() is a fresh headless agent run.
//
// NOTE (songc workarounds, see CLAUDE.md "song wishlist"):
//  - doc comments must be single-line (multi-line loses /// in codegen)
//  - AgentChunk.kind is i32, not enum ChunkKind (enum codecs not emitted yet)
//    kind values: 0 = TEXT, 1 = TOOL_EVENT, 2 = RESULT

namespace savannah;

/// One chunk of a streamed ask() response; kind: 0 TEXT, 1 TOOL_EVENT, 2 RESULT
struct AgentChunk {
    i32    kind;
    string payload;
}

/// Static identity of a node, returned by info()
struct AgentInfo {
    string   name;
    string   model;
    string   workspace;
    string[] tags;
    u32      protocol_ver;
}

/// Options for a single ask; v1 requires fresh_context = true
struct AskOptions {
    u32    timeout_ms;
    bool   fresh_context;
    string system_hint;
}

/// Node is already running an ask (v1 is single-flight)
error NodeBusy {
    string current_ask_id;
}

/// The underlying agent process failed before producing a result
error AgentFailed {
    string reason;
    i32    exit_code;
}

/// Request to create a task worker (a persistent, resumable claude session)
struct TaskSpec {
    string title;         // human label
    string prompt;        // first turn; empty = create idle, drive later
    string workdir;       // base dir; worktree is carved under it when make_worktree
    bool   make_worktree; // git worktree add for isolation (coding tasks)
    u32    timeout_ms;    // per-turn agent timeout; 0 = node default
}

/// Snapshot of one task worker
struct TaskInfo {
    string id;         // supervisor-assigned task id
    string title;
    string state;      // idle | running | done | failed | cancelled
    string worktree;   // cwd the worker runs in (worktree or workdir)
    string session_id; // claude session uuid (stable across turns)
    u32    turns;      // turns driven so far
    string last_line;  // last TEXT line, for at-a-glance status
}

/// task_list() result; array wrapped in a struct (songc-safe, see findings)
struct TaskList {
    TaskInfo[] tasks;
}

/// A single machine agent, exposed on the mesh
service AgentNode {
    /// Static identity and capabilities of this node
    info() -> AgentInfo;

    /// Run one stateless prompt; AgentChunk stream ends after a RESULT chunk
    stream ask(string prompt, AskOptions opts) -> AgentChunk throws NodeBusy;

    /// Cancel the in-flight ask, if any; true if something was cancelled
    cancel() -> bool;

    /// Returns idle or busy; v2 promotes this to a class property with push
    status() -> string;

    /// Create a task worker; runs spec.prompt as turn 1 if non-empty
    task_new(TaskSpec spec) -> TaskInfo;

    /// All task workers on this node
    task_list() -> TaskList;

    /// Drive one more turn on a task (async); false if the task is busy or gone
    task_send(string id, string prompt) -> bool;

    /// Snapshot one task
    task_status(string id) -> TaskInfo;

    /// Tail a task: replays its transcript, then follows the live turn to RESULT
    stream task_output(string id) -> AgentChunk;

    /// Cancel a task: kill any running turn, prune its worktree; true if it existed
    task_cancel(string id) -> bool;
}
